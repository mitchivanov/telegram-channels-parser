FROM python:3.11-slim

WORKDIR /app

# Устанавливаем зависимости
COPY requirements.txt ./
RUN apt-get update && apt-get install -y gcc && \
    pip install --no-cache-dir -r requirements.txt && \
    apt-get remove -y gcc && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Копируем необходимые файлы
COPY sync_google_sheets.py ./
COPY config_loader.py ./

# Скрипт для запуска синхронизации в цикле
RUN echo '#!/bin/bash\n\
set -e\n\
echo "[SYNC-SCHEDULER] Starting Google Sheets sync scheduler..."\n\
echo "[SYNC-SCHEDULER] Sync interval: ${SYNC_INTERVAL_MINUTES:-5} minutes"\n\
echo "[SYNC-SCHEDULER] Waiting 30 seconds for parser to authorize..."\n\
sleep 30\n\
echo "[SYNC-SCHEDULER] Checking if source Telegram session exists..."\n\
SOURCE_FILE="/app/session/${SOURCE_SESSION:-session_name}.session"\n\
TARGET_FILE="/app/session/${TELEGRAM_SESSION:-sync_session}.session"\n\
while [ ! -f "$SOURCE_FILE" ]; do\n\
    echo "[SYNC-SCHEDULER] Source session not found: $SOURCE_FILE. Waiting 10 more seconds..."\n\
    sleep 10\n\
done\n\
echo "[SYNC-SCHEDULER] ✓ Source session found: $SOURCE_FILE"\n\
if [ ! -f "$TARGET_FILE" ]; then\n\
    echo "[SYNC-SCHEDULER] Target session not found. Copying from source..."\n\
    cp "$SOURCE_FILE" "$TARGET_FILE"\n\
    echo "[SYNC-SCHEDULER] ✓ Session copied: $TARGET_FILE"\n\
else\n\
    echo "[SYNC-SCHEDULER] ✓ Target session already exists: $TARGET_FILE"\n\
fi\n\
echo "[SYNC-SCHEDULER] ✓ Starting sync loop..."\n\
while true; do\n\
    echo "[SYNC-SCHEDULER] $(date) - Running sync..."\n\
    python sync_google_sheets.py || echo "[SYNC-SCHEDULER] Sync failed, will retry later"\n\
    echo "[SYNC-SCHEDULER] $(date) - Sync completed. Sleeping for ${SYNC_INTERVAL_MINUTES:-5} minutes..."\n\
    sleep $((${SYNC_INTERVAL_MINUTES:-5} * 60))\n\
done' > /app/sync_loop.sh && chmod +x /app/sync_loop.sh

CMD ["/app/sync_loop.sh"]

